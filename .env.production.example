# Nouron — production environment template (R3, closed beta).
#
# Planned platform: Laravel Cloud. There these values are set in the
# environment settings, not in a committed file. This template lists what
# production needs and why. Never commit real secrets.
#
# Deploy notes:
#   - Never seed production: DatabaseSeeder and the dev commands
#     (db:reset, game:reset-player, colony:seed-demo, game:playtest)
#     refuse to run when APP_ENV=production.
#   - Run migrations with `php artisan migrate --force` (no --seed).
#   - Cache config/routes/views on deploy:
#       php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME=Nouron
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

BCRYPT_ROUNDS=12

# Closed beta: shared invite code required for registration (R9).
# Leaving it empty opens registration to everyone.
BETA_INVITE_CODE=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Database: decided in ROADMAP R5 (production database evaluation).
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions only over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Must support atomic locks: /sol/next locks each run (R11). `database` uses
# the cache/cache_locks tables (migrations exist); `redis` works as well.
# Avoid `file` with several app instances.
CACHE_STORE=database

QUEUE_CONNECTION=sync

# Mail is not needed for the beta yet (password reset via
# `php artisan user:reset-password`, mail-based reset is R20).
MAIL_MAILER=log
