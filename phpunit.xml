<?xml version="1.0" encoding="UTF-8"?>

<phpunit bootstrap="vendor/autoload.php" colors="true" defaultTestSuite="laravel-feature,laravel-unit">

    <testsuites>
        <testsuite name="laravel-feature">
            <directory>./tests/Feature</directory>
            <exclude>./tests/Feature/Playtest</exclude>
        </testsuite>
        <testsuite name="laravel-unit">
            <directory>./tests/Unit</directory>
        </testsuite>
        <testsuite name="playtest">
            <directory>./tests/Feature/Playtest</directory>
        </testsuite>

    </testsuites>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Forced: every test/bot process must use its own in-process cache and
             session store. A shared store from .env (file/database) lets parallel
             game:playtest processes — each with its own :memory: DB and run id 1 —
             collide on the /sol/next lock and share cached Sol deltas. -->
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!-- Laravel reads $_SERVER before getenv(), so the inherited value has to be
             overridden there as well. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <!-- Bypass all game rule checks by default in tests.
             Tests that specifically test AP/resource/supply behaviour
             override these via config(['game.bypass.ap_checks' => false]) in setUp(). -->
        <env name="GAME_BYPASS_AP" value="true"/>
        <env name="GAME_BYPASS_RESOURCES" value="true"/>
        <env name="GAME_BYPASS_SUPPLY" value="true"/>
    </php>

</phpunit>
