{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/colony/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Libre Baskerville))/i]",
        "message": "Font not provided by the design system. Available: Libre Baskerville."
      },
      {
        "selector": "JSXOpeningElement[name.name='APChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|children|key|ref|className|style|children)$/]",
        "message": "<APChip> doesn't accept that prop. Declared props: type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='APChip'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:nav|build|research|economy|strategy|neutral)$/]",
        "message": "<APChip> type must be one of 'nav' | 'build' | 'research' | 'economy' | 'strategy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|apCost|apType|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, apCost, apType, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='apType'] > Literal[value!=/^(?:build|nav|research|economy|strategy)$/]",
        "message": "<Button> apType must be one of 'build' | 'nav' | 'research' | 'economy' | 'strategy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|badge|footer|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, badge, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|id|name|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, id, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|footer|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, children, footer, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|level|description|key|ref|className|style|children)$/]",
        "message": "<EntityChip> doesn't accept that prop. Declared props: type, label, level, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityChip'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:building|knowledge|resource|ship|advisor|research)$/]",
        "message": "<EntityChip> type must be one of 'building' | 'knowledge' | 'resource' | 'ship' | 'advisor' | 'research'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|error|hint|children|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, htmlFor, error, hint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|value|onChange|placeholder|disabled|id|name|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: type, value, onChange, placeholder, disabled, id, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|number|email|password)$/]",
        "message": "<Input> type must be one of 'text' | 'number' | 'email' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|locked|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: key, label, icon, locked."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|segmented|segments|color|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, segmented, segments, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|disabled|id|name|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: value, min, max, step, onChange, disabled, id, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:sol|credits|supply|trust|resources|key|ref|className|style|children)$/]",
        "message": "<ResourceBar> doesn't accept that prop. Declared props: sol, credits, supply, trust, resources."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:abbr|amount|tone|empty|key|ref|className|style|children)$/]",
        "message": "<ResourceChip> doesn't accept that prop. Declared props: abbr, amount, tone, empty."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceChip'] > JSXAttribute[name.name='abbr'] > Literal[value!=/^(?:Cr|Sup|Rg|Co|Or|Tr|Sol|NX)$/]",
        "message": "<ResourceChip> abbr must be one of 'Cr' | 'Sup' | 'Rg' | 'Co' | 'Or' | 'Tr' | 'Sol' | 'NX'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResourceChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|warning|danger)$/]",
        "message": "<ResourceChip> tone must be one of 'default' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|danger|warning|neutral)$/]",
        "message": "<StatusBadge> tone must be one of 'success' | 'danger' | 'warning' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubnavTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|key|ref|className|style|children)$/]",
        "message": "<SubnavTab> doesn't accept that prop. Declared props: key, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|id|name|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, id, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|numeric|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, label, numeric."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
