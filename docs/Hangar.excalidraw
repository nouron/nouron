      "seed": 2022992773,
      "version": 503,
      "versionNonce": 708256853,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790513652357,
      "created": 1790431915653,
      "link": null,
      "locked": false,
      "text": "Durch den Konsul bekommt man AP aber\nwenn man alle angebotenen Gespräche\nführt soll daraus ein höherer AP\nVerbrauch entsteht der aber durch\neinen höheren Konsul-Rang wieder\nkompensiert werden kann, sodass\nungefähr ein Gleichgewicht entsteht",
      "fontSize": 14.726114649681527,
      "baseFontSize": 14.726114649681527,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Iw7vsEtoXboHAQw2tRx5B",
      "originalText": "Durch den Konsul bekommt man AP aber wenn man alle angebotenen Gespräche führt soll daraus ein höherer AP Verbrauch entsteht der aber durch einen höheren Konsul-Rang wieder kompensiert werden kann, sodass ungefähr ein Gleichgewicht entsteht",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
